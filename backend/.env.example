# Copy this file to .env and fill in your values:  copy .env.example .env

# ---------- Model (from Member 2) ----------
MODEL_PATH=models/efficientnetb0_fp16.tflite
CLASS_NAMES_PATH=models/class_names.json
MODEL_NAME=efficientnetb0-fp16
# raw_0_255 for keras EfficientNetB0 | mobilenet_v2 for MobileNetV2 | rescale_0_1 for /255 models
PREPROCESSING=raw_0_255
# Development only - random predictions when you have no model yet. Never for evidence.
USE_MOCK_MODEL=false

# ---------- MongoDB Atlas (optional: leave empty to run without history/auth) ----------
MONGODB_URI=
DB_NAME=smart_tomato

# ---------- Auth ----------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MAX_UPLOAD_MB=10
