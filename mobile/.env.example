# Copy to .env.local (not committed) and set your computer's address, then run: npx expo start -c
#   Android emulator: http://10.0.2.2:8000
#   Physical phone:   http://<your PC's IPv4 from ipconfig>:8000   (phone and PC on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# "api" (default) uses the real backend. "mock" shows fixed demo data with no server.
EXPO_PUBLIC_PREDICTION_MODE=api
